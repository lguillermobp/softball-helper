generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Global User Directory ───────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  isMasterAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  leagueRoles   UserLeagueRole[]

  @@map("users")
}

// ─── NextAuth Tables ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Plans ───────────────────────────────────────────────────────────────────

model Plan {
  id          String  @id @default(cuid())
  name        String  @unique  // e.g. "Free", "Starter", "Pro"
  maxTeams    Int
  maxSeasons  Int
  maxPlayers  Int
  price       Float
  isActive    Boolean @default(true)

  leagues League[]

  @@map("plans")
}

// ─── Leagues ─────────────────────────────────────────────────────────────────

model League {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique  // URL-friendly identifier
  logoUrl     String?
  city        String?
  state       String?
  status      LeagueStatus @default(ACTIVE)
  planId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plan        Plan             @relation(fields: [planId], references: [id])
  userRoles   UserLeagueRole[]
  seasons     Season[]
  categories  Category[]
  teams       Team[]

  @@map("leagues")
}

enum LeagueStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ─── Role-Based Access Control ───────────────────────────────────────────────

model UserLeagueRole {
  id        String     @id @default(cuid())
  userId    String
  leagueId  String
  role      LeagueRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId, role])  // same user can have only one of each role per league
  @@map("user_league_roles")
}

enum LeagueRole {
  LEAGUE_ADMIN
  UMPIRE
  SCORER
  TEAM_MANAGER
  PLAYER
}

// ─── Seasons ─────────────────────────────────────────────────────────────────

model Season {
  id        String       @id @default(cuid())
  leagueId  String
  name      String        // e.g. "Spring 2025"
  startDate DateTime
  endDate   DateTime
  status    SeasonStatus  @default(UPCOMING)
  createdAt DateTime      @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  Team[]

  @@map("seasons")
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id          String @id @default(cuid())
  leagueId    String
  name        String   // e.g. "Men's A", "Co-Ed", "Under 16"
  description String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  Team[]

  @@map("categories")
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id         String  @id @default(cuid())
  leagueId   String
  seasonId   String?
  categoryId String?
  name       String
  logoUrl    String?
  createdAt  DateTime @default(now())

  league   League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season   Season?   @relation(fields: [seasonId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("teams")
}
