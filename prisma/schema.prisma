generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Global User Directory ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  isMasterAdmin Boolean   @default(false)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  leagueRoles   UserLeagueRole[]
  players       Player[]
  managedTeams  Team[] @relation("TeamManager")
  assistedTeams Team[] @relation("TeamAssistant")

  @@map("users")
}

// ─── NextAuth Tables ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Plans ───────────────────────────────────────────────────────────────────

model Plan {
  id        String  @id @default(cuid())
  name      String  @unique
  maxTeams  Int
  maxSeasons Int
  maxPlayers Int
  price     Float
  isActive  Boolean @default(true)

  leagues League[]

  @@map("plans")
}

// ─── Leagues ─────────────────────────────────────────────────────────────────

model League {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  logoUrl   String?
  city      String?
  state     String?
  status    LeagueStatus @default(ACTIVE)
  planId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  plan       Plan             @relation(fields: [planId], references: [id])
  userRoles  UserLeagueRole[]
  seasons    Season[]
  categories Category[]
  teams      Team[]
  games      Game[]
  players    Player[]
  fields     Field[]

  @@map("leagues")
}

enum LeagueStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ─── Role-Based Access Control ───────────────────────────────────────────────

model UserLeagueRole {
  id        String     @id @default(cuid())
  userId    String
  leagueId  String
  role      LeagueRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId, role])
  @@map("user_league_roles")
}

enum LeagueRole {
  LEAGUE_ADMIN
  UMPIRE
  SCORER
  TEAM_MANAGER
  TEAM_ASSISTANT
  PLAYER
}

// ─── Seasons ─────────────────────────────────────────────────────────────────

model Season {
  id        String       @id @default(cuid())
  leagueId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    SeasonStatus @default(UPCOMING)
  createdAt DateTime     @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  Team[]
  games  Game[]

  @@map("seasons")
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  leagueId    String
  name        String
  description String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  Team[]
  games  Game[]

  @@map("categories")
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id          String     @id @default(cuid())
  leagueId    String
  seasonId    String?
  categoryId  String?
  managerId   String?
  assistantId String?
  name        String
  status      TeamStatus @default(PENDING)
  isActive    Boolean    @default(true)
  logoUrl     String?
  createdAt   DateTime   @default(now())

  league    League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season    Season?   @relation(fields: [seasonId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])
  manager   User?     @relation("TeamManager", fields: [managerId], references: [id])
  assistant User?     @relation("TeamAssistant", fields: [assistantId], references: [id])
  homeGames Game[]    @relation("HomeGames")
  awayGames Game[]    @relation("AwayGames")
  players   Player[]

  @@map("teams")
}

// ─── Fields ──────────────────────────────────────────────────────────────────

model Field {
  id        String      @id @default(cuid())
  leagueId  String
  name      String
  types     FieldType[]
  createdAt DateTime    @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  games  Game[]

  @@map("fields")
}

enum TeamStatus {
  PENDING
  APPROVED
}

enum FieldType {
  MORNING
  AFTERNOON
  NIGHT
}

// ─── Games ───────────────────────────────────────────────────────────────────

model Game {
  id           String     @id @default(cuid())
  leagueId     String
  seasonId     String
  categoryId   String?
  homeTeamId   String
  awayTeamId   String
  fieldId      String?
  scheduledAt  DateTime
  homeAwayTbd  Boolean    @default(false)
  status       GameStatus @default(SCHEDULED)
  homeScore    Int?
  awayScore    Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  league   League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season   Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  field    Field?    @relation(fields: [fieldId], references: [id])
  homeTeam Team      @relation("HomeGames", fields: [homeTeamId], references: [id])
  awayTeam Team      @relation("AwayGames", fields: [awayTeamId], references: [id])

  @@map("games")
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Players ─────────────────────────────────────────────────────────────────

model Player {
  id           String   @id @default(cuid())
  name         String
  email        String
  jerseyNumber String?
  photoUrl     String?
  teamId       String
  leagueId     String
  userId       String?
  createdAt    DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@unique([email, teamId])
  @@map("players")
}
