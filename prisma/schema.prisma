generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Global User Directory ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  emailVerified DateTime?
  image         String?
  isMasterAdmin Boolean   @default(false)
  isActive      Boolean   @default(true)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  leagueRoles   UserLeagueRole[]
  players       Player[]
  managedTeams  Team[]        @relation("TeamManager")
  assistedTeams Team[]        @relation("TeamAssistant")
  officialRoles GameOfficial[]
  conditions    Condition[]   @relation("ConditionAuthor")

  @@map("users")
}

// ─── NextAuth Tables ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Plans ───────────────────────────────────────────────────────────────────

model Plan {
  id            String  @id @default(cuid())
  name          String  @unique
  maxTeams      Int
  maxSeasons    Int
  maxPlayers    Int
  price         Float
  isActive      Boolean @default(true)
  stripePriceId String?

  leagues League[]

  @@map("plans")
}

// ─── Leagues ─────────────────────────────────────────────────────────────────

model League {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  logoUrl              String?
  city                 String?
  state                String?
  status               LeagueStatus @default(ACTIVE)
  planId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String       @default("active")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  plan       Plan             @relation(fields: [planId], references: [id])
  userRoles   UserLeagueRole[]
  seasons     Season[]
  categories  Category[]
  teams       Team[]
  games       Game[]
  players     Player[]
  fields      Field[]
  conditions  Condition[]
  publicPage  LeaguePublicPage?

  @@map("leagues")
}


enum LeagueStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// ─── Role-Based Access Control ───────────────────────────────────────────────

model UserLeagueRole {
  id        String     @id @default(cuid())
  userId    String
  leagueId  String
  role      LeagueRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId, role])
  @@map("user_league_roles")
}

enum LeagueRole {
  LEAGUE_ADMIN
  UMPIRE
  SCOREKEEPER
  TEAM_MANAGER
  TEAM_MANAGER_PLAYER
  TEAM_ASSISTANT
  TEAM_ASSISTANT_PLAYER
  PLAYER
}

// ─── Seasons ─────────────────────────────────────────────────────────────────

model Season {
  id             String       @id @default(cuid())
  leagueId       String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         SeasonStatus @default(UPCOMING)
  reEntryAllowed Boolean      @default(true)
  reEntryLimit   Int          @default(1)
  createdAt      DateTime     @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  Team[]
  games  Game[]

  @@map("seasons")
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  leagueId    String
  name        String
  description String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teams  Team[]
  games  Game[]

  @@map("categories")
}

// ─── Teams ───────────────────────────────────────────────────────────────────

model Team {
  id          String     @id @default(cuid())
  leagueId    String
  seasonId    String?
  categoryId  String?
  managerId   String?
  assistantId String?
  name        String
  group       String?
  status      TeamStatus @default(PENDING)
  isActive    Boolean    @default(true)
  logoUrl     String?
  createdAt   DateTime   @default(now())

  league    League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season    Season?   @relation(fields: [seasonId], references: [id])
  category  Category? @relation(fields: [categoryId], references: [id])
  manager   User?     @relation("TeamManager", fields: [managerId], references: [id])
  assistant User?     @relation("TeamAssistant", fields: [assistantId], references: [id])
  homeGames  Game[]             @relation("HomeGames")
  awayGames  Game[]             @relation("AwayGames")
  players    Player[]
  scorebooks ManagerScorebook[]
  publicPage TeamPublicPage?

  @@map("teams")
}

// ─── Fields ──────────────────────────────────────────────────────────────────

model Field {
  id        String      @id @default(cuid())
  leagueId  String
  name      String
  types     FieldType[]
  createdAt DateTime    @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  games  Game[]

  @@map("fields")
}

enum TeamStatus {
  PENDING
  APPROVED
}

enum FieldType {
  MORNING
  AFTERNOON
  NIGHT
}

// ─── Games ───────────────────────────────────────────────────────────────────

model Game {
  id                String     @id @default(cuid())
  leagueId          String
  seasonId          String
  categoryId        String?
  homeTeamId        String
  awayTeamId        String
  fieldId           String?
  scheduledAt       DateTime
  homeAwayTbd       Boolean    @default(false)
  status            GameStatus @default(SCHEDULED)
  homeScore         Int?
  awayScore         Int?
  startedAt         DateTime?
  lineupsLocked     Boolean    @default(false)
  cancelReason      String?
  isPractice        Boolean    @default(false)
  rescheduledFromId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  league          League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season          Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id])
  field           Field?    @relation(fields: [fieldId], references: [id])
  homeTeam        Team      @relation("HomeGames", fields: [homeTeamId], references: [id])
  awayTeam        Team      @relation("AwayGames", fields: [awayTeamId], references: [id])
  officials       GameOfficial[]
  lineups         GameLineup[]
  scorebooks      ManagerScorebook[]
  atBats          GameAtBat[]
  innings         GameInning[]
  pitcherStints   GamePitcherStint[]
  substitutions   GameSubstitution[]
  rescheduledFrom Game?     @relation("GameReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Game[]    @relation("GameReschedule")

  @@map("games")
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum OfficialRole {
  UMPIRE
  SCOREKEEPER
}

// ─── Players ─────────────────────────────────────────────────────────────────

model Player {
  id           String   @id @default(cuid())
  name         String
  email        String?
  jerseyNumber String?
  nationality  String?
  photoUrl     String?
  teamId       String
  leagueId     String
  userId       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  gameLineups      GameLineup[]
  atBatsAsBatter   GameAtBat[]        @relation("BatterAtBats")
  atBatsAsPitcher  GameAtBat[]        @relation("PitcherAtBats")
  pitcherStints    GamePitcherStint[]
  substitutionsIn  GameSubstitution[] @relation("SubIn")
  substitutionsOut GameSubstitution[] @relation("SubOut")

  @@unique([email, teamId])
  @@map("players")
}

model GameOfficial {
  id        String       @id @default(cuid())
  gameId    String
  game      Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  role      OfficialRole
  createdAt DateTime     @default(now())

  @@unique([gameId, userId])
  @@map("game_officials")
}

model GameLineup {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  isHome       Boolean
  position     String
  battingOrder Int?
  createdAt    DateTime @default(now())

  @@unique([gameId, playerId])
  @@map("game_lineups")
}

// ─── Official Scoring ────────────────────────────────────────────────────────

enum AtBatOutcome {
  SINGLE
  DOUBLE
  TRIPLE
  HOME_RUN
  WALK
  OUT
  STRIKEOUT
}

model GameAtBat {
  id           String       @id @default(cuid())
  gameId       String
  inningNumber Int
  isTop        Boolean
  batterId     String
  pitcherId    String
  outcome      AtBatOutcome
  sequence     Int
  createdAt    DateTime     @default(now())

  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  batter  Player @relation("BatterAtBats", fields: [batterId], references: [id])
  pitcher Player @relation("PitcherAtBats", fields: [pitcherId], references: [id])

  @@map("game_at_bats")
}

model GameInning {
  id           String   @id @default(cuid())
  gameId       String
  inningNumber Int
  isTop        Boolean
  runsScored   Int      @default(0)
  completed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, inningNumber, isTop])
  @@map("game_innings")
}

model GamePitcherStint {
  id          String   @id @default(cuid())
  gameId      String
  pitcherId   String
  isHome      Boolean
  inningStart Int
  isTopStart  Boolean
  outsAtStart Int      @default(0)
  inningEnd   Int?
  isTopEnd    Boolean?
  outsAtEnd   Int?
  createdAt   DateTime @default(now())

  game    Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  pitcher Player @relation(fields: [pitcherId], references: [id])

  @@map("game_pitcher_stints")
}

model GameSubstitution {
  id               String   @id @default(cuid())
  gameId           String
  teamId           String
  inningNumber     Int
  isTop            Boolean
  playerInId       String
  playerOutId      String
  battingOrderSpot Int
  position         String?
  isReEntry        Boolean  @default(false)
  createdAt        DateTime @default(now())

  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerIn  Player @relation("SubIn",  fields: [playerInId],  references: [id])
  playerOut Player @relation("SubOut", fields: [playerOutId], references: [id])

  @@map("game_substitutions")
}

// ─── Season Conditions ────────────────────────────────────────────────────────

model Condition {
  id          String   @id @default(cuid())
  leagueId    String
  title       String
  content     String?  @db.Text
  fileUrl     String?
  fileName    String?
  fileType    String?
  order       Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  createdBy User   @relation("ConditionAuthor", fields: [createdById], references: [id])

  @@map("conditions")
}

// ─── Manager Scorebook ───────────────────────────────────────────────────────

model ManagerScorebook {
  id        String   @id @default(cuid())
  gameId    String
  teamId    String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameId, teamId])
  @@map("manager_scorebooks")
}

// ─── Public Pages ────────────────────────────────────────────────────────────

model LeaguePublicPage {
  id            String   @id @default(cuid())
  leagueId      String   @unique
  published     Boolean  @default(false)
  description   String?  @db.Text
  showStandings Boolean  @default(true)
  showSchedule  Boolean  @default(true)
  showTeams     Boolean  @default(true)
  socialLinks   Json?
  updatedAt     DateTime @updatedAt

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@map("league_public_pages")
}

model TeamPublicPage {
  id           String   @id @default(cuid())
  teamId       String   @unique
  published    Boolean  @default(false)
  description  String?  @db.Text
  showRoster   Boolean  @default(true)
  showStats    Boolean  @default(true)
  showSchedule Boolean  @default(true)
  socialLinks  Json?
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_public_pages")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  userEmail  String?
  action     String
  entityType String?
  entityId   String?
  leagueId   String?
  leagueName String?
  metadata   Json?
  ipAddress  String?
  location   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([leagueId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
